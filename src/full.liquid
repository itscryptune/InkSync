<div class="layout">
  <div class="ink-shell ink-full">
    <div class="ink-main">
      <div class="ink-paper">
        <div class="ink-canvas">
          {% if has_sketch and ink_url %}
            <img class="ink-image" src="{{ ink_url | escape }}" alt="Latest InkSync drawing">
          {% endif %}
        </div>
      </div>
      <div class="ink-join">
        <div class="ink-details">
          <div class="ink-detail">
            <div class="ink-details-label">DRAWN BY</div>
            <div class="ink-details-value">{{ sketch_author | default: 'Waiting for sketch' | truncate: 24 | escape }}</div>
          </div>
          <div class="ink-detail">
            <div class="ink-details-label">LAST SENT</div>
            <div class="ink-details-time">{{ sketch_sent_at | default: 'Not sent yet' | escape }}</div>
          </div>
        </div>
        <div class="ink-join-bottom">
          {% if qr_url %}
            <img class="ink-qr-image" src="{{ qr_url | escape }}" alt="Scan to open InkSync">
          {% else %}
            <div class="ink-qr-placeholder">QR UNAVAILABLE</div>
          {% endif %}
          <div class="ink-join-title">SCAN TO DRAW</div>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="title_bar">
  <span class="title">InkSync</span>
  <span class="instance">itscryptune</span>
</div>